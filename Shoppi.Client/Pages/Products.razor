@page "/products"

@using Shoppi.Client.DTOs
@using Shoppi.Client.DTOs.ProductDTOClient
@using Shoppi.Client.Services.Contracts
@using MudBlazor
@using Shoppi.Client.Shared.Components

@inject IProductService ProductService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="mt-4 pt-6">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h4">Products</MudText>

        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenAdd">
            Add Product
        </MudButton>
    </MudStack>

    <MudDivider Class="my-3" />

    @if (products is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!products.Any())
    {
        <MudAlert Severity="Severity.Info">
            No products found
        </MudAlert>
    }
    else
    {
        <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:15px;">

            @foreach (var product in products)
            {
                <MudPaper Class="pa-4">

                    <MudText Typo="Typo.h6">@product.Name</MudText>

                    <MudText>
                        <b>Price:</b> @product.Price
                    </MudText>

                    <MudText Class="mb-2">
                        @product.Description
                    </MudText>

                    <MudText Typo="Typo.caption">
                        Category: @product.CategoryName
                    </MudText>

                    <MudStack Row="true" Spacing="2" Class="mt-3">

                        <MudButton Color="Color.Warning"
                                   Size="Size.Small"
                                   OnClick="@(() => OpenEdit(product))">
                            Edit
                        </MudButton>

                        <MudButton Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => ConfirmDelete(product.Id))">
                            Delete
                        </MudButton>

                    </MudStack>

                </MudPaper>
            }

        </div>
    }

</div>

@code {

    private IEnumerable<ProductDTOClient>? products;

    // Configuration settings to make the product modal wider and cleaner
    private readonly DialogOptions _productDialogOptions = new()
    {
        CloseButton = true,
        MaxWidth = MaxWidth.Medium, // Fixes the squished look by giving it a medium width
        FullWidth = true
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        products = await ProductService.GetProducts();
    }

    // OPEN ADD DIALOG
    private async Task OpenAdd()
    {
        // Leaving the first title string empty ("") because MudDialog's TitleContent inside the modal handles it
        var dialog = DialogService.Show<ProductDialog>("", _productDialogOptions);
        var result = await dialog.Result;

        if (!result.Canceled)
            await LoadProducts();
    }

    // OPEN EDIT DIALOG (IMPORTANT: PASS COPY, NOT REFERENCE)
    private async Task OpenEdit(ProductDTOClient product)
    {
        var parameters = new DialogParameters
        {
            ["Product"] = new ProductDTOClient
            {
                Id = product.Id,
                Name = product.Name,
                Price = product.Price,
                Description = product.Description,
                ImageURL = product.ImageURL,
                QuantityInStock = product.QuantityInStock,
                CategoryId = product.CategoryId,
                CategoryName = product.CategoryName
            }
        };

        // Added _productDialogOptions here to widen the edit modal as well
        var dialog = DialogService.Show<ProductDialog>("", parameters, _productDialogOptions);
        var result = await dialog.Result;

        if (!result.Canceled)
            await LoadProducts();
    }

    // DELETE CONFIRM DIALOG
    private async Task ConfirmDelete(int id)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = "Are you sure you want to delete this product?"
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = DialogService.Show<SimpleConfirmDialog>("Confirm Delete", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await ProductService.DeleteProduct(id);
            await LoadProducts();
            Snackbar.Add("Product deleted", Severity.Success);
        }
    }
}